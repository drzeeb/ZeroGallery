<?xml version="1.0" encoding="utf-8"?>
<!-- ZeroGallery mark: two overlapping photo cards (a gallery, stacked) with a mountain/sun
     glyph cut out of the front card in the exact background color, so it reads as a hole
     punched through the card revealing the backdrop behind it - one flat, opaque white shape
     plus a translucent "second card" peeking out from behind it, no gradients or photographic
     detail, so it still reads clearly as a monochrome/themed icon on Android 13+. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Back card, peeking out top-left, softly translucent for depth. -->
    <path
        android:fillColor="#8AFFFFFF"
        android:pathData="M27.7,34.9L73.1,27.7L80.3,73.1L34.9,80.3Z" />
    <!-- Front card, solid. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M35.1,33.1L80.9,37.1L76.9,82.9L31.1,78.9Z" />
    <!-- Mountain range + sun, punched through the front card in the backdrop color. -->
    <path
        android:fillColor="@color/ic_launcher_background"
        android:pathData="M54,44L70,70L38,70Z M63,52L76,70L50,70Z" />
    <path
        android:fillColor="@color/ic_launcher_background"
        android:pathData="M62.5,45A4.5,4.5 0,1,1 71.5,45A4.5,4.5 0,1,1 62.5,45Z" />
</vector>


<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Granular media permissions (API 33+). No INTERNET permission is ever declared:
         ZeroGallery is architecturally incapable of network access. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Legacy storage permission, required up to API 32. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Special permission (API 30+), requested only when the user opts into the folder view's
         "show hidden folders" toggle. MediaStore's own media scanner never indexes dot-prefixed
         directories (the convention several vault/messaging apps use to hide their media from
         gallery apps) at all, so no ContentResolver query can ever surface that content - reading
         it back requires raw filesystem access, which in turn requires this permission on modern,
         scoped-storage Android. See HiddenMediaScanner/AllFilesAccessPermission. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Media3/ExoPlayer's manifest requests this to detect connection type for adaptive
         streaming, which ZeroGallery never does (local playback only). Stripped to keep the
         "no network capability whatsoever" guarantee airtight. -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <!-- Android 11+ package visibility: lets AllFilesAccessPermission#requestIntent check whether
         the per-app "All files access" settings screen resolves before falling back to the
         general one. -->
    <queries>
        <intent>
            <action android:name="android.settings.MANAGE_APP_ALL_FILES_ACCESS_PERMISSION" />
        </intent>
    </queries>

    <application
        android:name=".ZeroGalleryApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZeroGallery">
        <!-- configChanges: without this, rotating the device destroys and recreates the whole
             Activity (and with it the entire Compose composition), which used to restart any
             playing video from the beginning - its ExoPlayer instance lived in a plain
             `remember` inside VideoPlayer, not anything that survives recreation. Handling these
             configuration changes ourselves instead keeps the Activity (and every in-memory
             composable/player) alive across rotation; Compose already reacts to the new
             Configuration reactively via LocalConfiguration.current (see
             rememberWindowWidthSizeClass), so adaptive/tablet layouts keep working correctly. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:theme="@style/Theme.ZeroGallery"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lets MediaSharer share HiddenMediaScanner's file:// items (raw filesystem paths, never
             indexed by MediaStore) without a FileUriExposedException - rewrites them to a
             temporary, revocable content:// uri instead of exposing the raw path. Regular
             MediaStore items are already content:// and never need this. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
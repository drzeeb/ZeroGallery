<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- The user-picked hidden folder's uri (see HiddenFolderAccess) refers to a persisted
         Storage Access Framework grant that Auto Backup never actually restores - only this uri
         string would come back, pointing at a folder the app has no real permission to read
         anymore. Excluded so a restore never resurrects that broken, silently-failing state;
         HiddenMediaScanner also defends against it directly for anyone upgrading from a backup
         made before this exclusion existed. -->
    <exclude domain="sharedpref" path="hidden_folder_access.xml" />
</full-backup-content>
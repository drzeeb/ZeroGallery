<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Granular media permissions (API 33+). No INTERNET permission is ever declared:
         ZeroGallery is architecturally incapable of network access. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Legacy storage permission, required up to API 32. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Deliberately no MANAGE_EXTERNAL_STORAGE ("All files access") permission: the folder
         view's "show hidden folders" toggle used to need it to read dot-prefixed folders
         MediaStore never indexes, but that's broad, whole-device-storage access for the sake of
         one narrow feature - exactly what Google Play's review explicitly polices for apps (like
         a gallery) whose core functionality doesn't otherwise need it. HiddenMediaScanner now
         reads via the Storage Access Framework instead (see HiddenFolderAccess), scoped to just
         the one folder the user explicitly picks via the system's own folder picker, which needs
         no manifest permission at all. -->

    <!-- Media3/ExoPlayer's manifest requests this to detect connection type for adaptive
         streaming, which ZeroGallery never does (local playback only). Stripped to keep the
         "no network capability whatsoever" guarantee airtight. -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />


    <application
        android:name=".ZeroGalleryApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZeroGallery">
        <!-- configChanges: without this, rotating the device destroys and recreates the whole
             Activity (and with it the entire Compose composition), which used to restart any
             playing video from the beginning - its ExoPlayer instance lived in a plain
             `remember` inside VideoPlayer, not anything that survives recreation. Handling these
             configuration changes ourselves instead keeps the Activity (and every in-memory
             composable/player) alive across rotation; Compose already reacts to the new
             Configuration reactively via LocalConfiguration.current (see
             rememberWindowWidthSizeClass), so adaptive/tablet layouts keep working correctly. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:theme="@style/Theme.ZeroGallery"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>

